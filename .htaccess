Options -Indexes
# La landing es index.html; evita que el index.php de ejemplo de Cloudways tome la raíz.
DirectoryIndex index.html index.php
RewriteEngine On
RewriteRule ^api/solicitudes/?$ api/solicitudes.php [L]
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
